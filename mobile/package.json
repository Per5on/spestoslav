{
  "name": "spestoslav-mobile",
  "version": "0.5.4",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-model.cjs && node scripts/test-cache.cjs && node scripts/test-preview-metadata.cjs && node scripts/test-network.cjs && node scripts/test-errors.cjs",
    "build:android:preview": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "postinstall": "node scripts/patch-dependencies.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "expo": "$expo",
    "react-native": "$react-native",
    "expo-font": "$expo-font",
    "postcss": "^8.5.33",
    "glob@>=9 <=14.0.1": "^14.0.6",
    "minimatch@>=7 <11.0.1": "^11.0.8",
    "image-size": "^2.1.0"
  }
}
