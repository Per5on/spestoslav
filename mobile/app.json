{
  "expo": {
    "slug": "spestoslav",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "bg.spestoslav.preview",
      "icon": "./assets/money-bag-logo.png",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/money-bag-logo.png",
        "backgroundColor": "#195b27"
      }
    },
    "icon": "./assets/scale-launcher.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f5"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-background-task",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешете камерата за баркодове и касови бележки.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Изберете снимка на баркод или касова бележка.",
          "cameraPermission": "Снимайте касова бележка.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
