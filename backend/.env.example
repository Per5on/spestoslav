# Hosted database, or localhost PostgreSQL for development. Never point Alembic at Flyway preview.
DATABASE_URL=postgresql://postgres:password@localhost:5432/spestoslav
# Managed Auth URL from the same Neon branch. Android obtains JWTs via @neon/auth.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional audience when your provider issues one; issuer and EdDSA signature are always checked.
AUTH_AUDIENCE=
# Comma-separated verified subject IDs; never a client-supplied role.
ADMIN_SUBJECTS=
# Random 32+ character server credentials. Never put these into Android EXPO_PUBLIC variables.
ADMIN_API_KEY=
COLLECTOR_API_KEY=
# Private S3-compatible receipt bucket. Use distinct credentials for each branch.
RECEIPT_S3_BUCKET=receipts
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local development only; leave empty on an ephemeral Render filesystem.
RECEIPT_STORAGE_DIR=
OCR_LANGUAGES=bul+eng
# Optional paid station-price API integration. No scraping fallback or paid signup.
FUELO_API_KEY=
API_BASE_URL=https://spestoslav-api.onrender.com
# Optional explicitly labeled reference-product preview; never real verified prices.
ENABLE_DEMO_CATALOG=false
