# Hosted database, or localhost PostgreSQL for development. Never point Alembic at Flyway preview.
DATABASE_URL=postgresql://postgres:password@localhost:5432/spestoslav
# Managed Auth URL from the same Neon branch. Android obtains JWTs via @neon/auth.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional audience when your provider issues one; issuer and EdDSA signature are always checked.
AUTH_AUDIENCE=
# Comma-separated verified subject IDs; never a client-supplied role.
ADMIN_SUBJECTS=
# Production: set AUTH_AUDIENCE and AUTH_REQUIRE_AUDIENCE=true so tokens minted for any
# other app on the same issuer are rejected. Left unset, a startup warning is logged.
AUTH_REQUIRE_AUDIENCE=false
# Rate limits key on the client address. Behind a reverse proxy (e.g. Render) set this to
# the number of proxies you trust; 0 uses the socket address. Verify with a test request.
TRUSTED_PROXY_HOPS=0
# Receipts one person may upload per rolling 24 hours (0 disables the cap).
RECEIPT_DAILY_LIMIT=30
# Other per-person daily caps (0 disables): barcode identification requests, price submissions.
IDENTIFICATION_DAILY_LIMIT=50
SUBMISSION_DAILY_LIMIT=200
# Where feedback is delivered; defaults to the maintainer address in code.
FEEDBACK_RECIPIENT=
# Random 32+ character server credentials. Never put these into Android EXPO_PUBLIC variables.
ADMIN_API_KEY=
COLLECTOR_API_KEY=
# Private S3-compatible receipt bucket. Use distinct credentials for each branch.
RECEIPT_S3_BUCKET=receipts
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local development only; leave empty on an ephemeral Render filesystem.
RECEIPT_STORAGE_DIR=
OCR_LANGUAGES=bul+eng
# Optional paid station-price API integration. No scraping fallback or paid signup.
FUELO_API_KEY=
API_BASE_URL=https://spestoslav-api.onrender.com
# Optional explicitly labeled reference-product preview; never real verified prices.
ENABLE_DEMO_CATALOG=false

# Passwordless OCR runner: exact approved GitHub workflow/main identity only.
RECEIPT_WORKER_OIDC_ENABLED=false
RECEIPT_WORKER_AUDIENCE=https://spestoslav-api.onrender.com/receipt-worker

# Enable only after a supported provider is configured and delivery is verified.
# Render Free blocks SMTP465/587; a password alone cannot enable Yahoo delivery.
FEEDBACK_DELIVERY_ENABLED=false
FEEDBACK_PROVIDER=brevo
FEEDBACK_BREVO_API_KEY=
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASSWORD=
FEEDBACK_FROM=
